--- a/mozjs-sys/src/jsval.rs
+++ b/mozjs-sys/src/jsval.rs
@@ -212,7 +212,14 @@
 #[inline(always)]
 pub fn PrivateValue(o: *const c_void) -> JSVal {
     let ptrBits = o as usize as u64;
-    #[cfg(target_pointer_width = "64")]
+    // Android arm64 uses tagged native heap pointers. Preserve the full
+    // pointer (including its top-byte tag) in SpiderMonkey private slots.
+    #[cfg(all(target_pointer_width = "64", target_os = "android", target_arch = "aarch64"))]
+    {
+        assert_eq!(ptrBits & 0x00FF000000000000, 0);
+        assert!(ptrBits <= ValueShiftedTag::MAX_DOUBLE as u64);
+    }
+    #[cfg(all(target_pointer_width = "64", not(all(target_os = "android", target_arch = "aarch64"))))]
     assert_eq!(ptrBits & 0xFFFF000000000000, 0);
     AsJSVal(ptrBits)
 }
